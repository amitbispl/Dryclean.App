{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=dryclean;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_RANDOM_64_CHAR_SECRET (generate: [Convert]::ToBase64String((New-Object byte[] 48 | % {[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($_); $_})))",
    "Issuer": "DrycleanApi",
    "Audience": "DrycleanApp",
    "ExpiryHours": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
